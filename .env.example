# Server Configuration
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
SERVICE_NAME=takcakap-api
LOG_LEVEL=info
# Log CORS preflight OPTIONS requests (can be noisy in production)
LOG_HTTP_OPTIONS=false
# Log cache revalidation 304 responses (very noisy under normal browser usage)
LOG_HTTP_304=false
# Log successful static asset requests (/assets, *.js, *.css, *.png, *.mp3, etc.)
LOG_HTTP_STATIC=false
# Log successful SSE lifecycle requests (/api/admin/orders/stream and stream-token)
LOG_HTTP_SSE=false
# Suppress successful request logs for noisy polling routes (errors still logged)
LOG_HTTP_SUPPRESS_ROUTES=/api/shop-status,/shop-status
# Add a blank line after each console JSON log entry for readability
LOG_CONSOLE_EXTRA_NEWLINE=false
LOG_TO_FILE=true
LOG_DIR=./server/logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=20971520
METRICS_ENABLED=true
# Optional: set a bearer token to protect /metrics and /api/metrics
METRICS_AUTH_TOKEN=
# Optional override. If unset: true in production, false in development.
# METRICS_REQUIRE_AUTH=true
METRICS_PREFIX=foodiedash_

# Frontend (Vite) Dev Server
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3000
# Comma-separated hostnames allowed to access Vite dev server via Host header.
# Example: VITE_ALLOWED_HOSTS=takcakap.com,api-b.takcakap.com,localhost,127.0.0.1
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend API (Configurable for LAN/domain/reverse proxy)
# Keep `/api` when frontend and backend are served from the same domain.
VITE_API_BASE_URL=/api
# Public frontend URL for links inside transactional emails
PUBLIC_APP_URL=https://foodie.example.com
# For split-domain deployment, use full API origin, e.g.:
# VITE_API_BASE_URL=https://api.example.cloud/api

# Used by Vite dev proxy only (when running `npm run dev`)
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# Dev only: set false to disable Vite /api proxy and call VITE_API_BASE_URL directly
VITE_USE_DEV_PROXY=true
VITE_BRAND_LOGO_URL=https://res.cloudinary.com/dzayh29d7/image/upload/v1771021189/Xcakap_qn50xm.png
VITE_DUITNOW_LOGO_URL=/duitnow-logo.png
VITE_DUITNOW_QR_URL=https://res.cloudinary.com/dzayh29d7/image/upload/v1770301357/KC_QR_vljdez.png
VITE_ADMIN_ORDER_ALERT_SOUND_URL=/admin-order-alert.mp3

# Email Notifications (SMTP)
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=TakCakap
SMTP_FROM_EMAIL=
SMTP_TLS_SERVERNAME=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Database Configuration (MariaDB)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=takcakap
DB_PORT=3306

# Lalamove (Malaysia Sandbox)
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
LALAMOVE_API_KEY=pk_test_xxx
LALAMOVE_API_SECRET=sk_test_xxx
LALAMOVE_MARKET=MY
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
LALAMOVE_LANGUAGE=en_MY
LALAMOVE_ROUTE_OPTIMIZED=true
LALAMOVE_PARTNER=
# Rider remark template for each Lalamove order.
# Supported tokens: {orderId}, {userName}
LALAMOVE_DEFAULT_REMARK_TEMPLATE=Order #{orderId} | User: {userName}
# Optional legacy fallback (not required for v3 webhook validation with API key/secret)
LALAMOVE_WEBHOOK_SECRET=
LALAMOVE_HTTP_TIMEOUT_MS=12000
LALAMOVE_WEBHOOK_MAX_SKEW_SECONDS=600
DUITNOW_QR_URL=https://res.cloudinary.com/dzayh29d7/image/upload/v1770301357/KC_QR_vljdez.png
SHOP_OPEN_TIME=09:00
SHOP_CLOSE_TIME=22:00

# Curlec Hosted Checkout
CURLEC_API_BASE_URL=https://api.razorpay.com/v1
CURLEC_KEY_ID=
CURLEC_KEY_SECRET=
CURLEC_WEBHOOK_SECRET=replace_with_strong_shared_secret
# Optional during secret rotation to accept retries signed with previous secret
CURLEC_WEBHOOK_OLD_SECRET=
CURLEC_HTTP_TIMEOUT_MS=12000
INTERNAL_ORDER_RECONCILIATION_TIMEOUT_MS=25000
CURLEC_CHECKOUT_NAME=TakCakap
CURLEC_CHECKOUT_DESCRIPTION=Secure checkout via Curlec
CURLEC_THEME_COLOR=#499c49
ALLOW_UNVERIFIED_DUITNOW_ORDERS=false

# Authentication
JWT_SECRET=replace_with_at_least_32_chars_random_secret
ADMIN_EMAIL=admin@takcakap.com
ADMIN_PASSWORD=change_me_to_a_strong_password
TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=12
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=600
ADMIN_ORDER_STREAM_TOKEN_TTL_SECONDS=120

# CORS (comma-separated allowlist for browser origins)
# Leave empty to allow all origins (dev-friendly, less secure).
# Example: CORS_ORIGINS=https://example.cloud,https://www.example.cloud,http://localhost:3000
CORS_ORIGINS=

# Google OAuth / Google Identity Services
# Use the same Web client ID for frontend and backend verification.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Cloudflare R2 Storage (Optional)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL_PREFIX=https://assets.takcakap.com
