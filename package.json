{
  "name": "takcakap",
  "version": "1.0.0",
  "description": "Full Stack Food Delivery App",
  "main": "server/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:e2e:critical",
    "test:e2e:critical": "node server/webhook_sim_runner.js",
    "db:migrate": "node server/runMigrations.js",
    "start": "npm run start:prod",
    "start:dev": "concurrently -k -n API,WEB -c blue,green \"npm:backend:start\" \"npm:dev:noproxy\"",
    "server:dev": "nodemon server/index.js",
    "dev:proxy": "vite",
    "dev:noproxy": "VITE_USE_DEV_PROXY=false vite",
    "backend:start": "node server/index.js",
    "start:prod": "node server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
